# EcoBoty — template .env (copier vers `.env`)
# 1 site = https://ecoboty.eu · plus d'api.ecoboty.eu

# --- LOCAL (actif en dev) ---
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
API_BASE=http://localhost:4000
API_SECRET_KEY=change_me_long_random
API_JWT_TTL=30d
ADMIN_USER_IDS=

ADSENSE_CLIENT=
TAWK_TO_WIDGET_URL=
ENDORSELY_ID=ea1de630-1f10-474d-b82d-29331955cd3d

DATABASE_URL=mysql://user:password@127.0.0.1:3306/discord_economy

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# Twitch optionnel
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK=http://localhost:4000/twitch/eventsub

# Top.gg (listing + votes) — ne jamais committer le token
TOPGG_ENABLED=1
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=
TOPGG_BOT_PAGE_URL=https://top.gg/fr/bot/1465377603090383161

# Stripe (Billing) — clés TEST en local, LIVE en prod. Ne jamais committer les vraies clés.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2025-03-31.basil
STRIPE_WEBHOOK_SECRET=
# IDs catalogue (optionnel — sinon création/recherche auto au démarrage + bouton Admin V2 > Stripe / Premium > Synchroniser)
STRIPE_PRODUCT_PREMIUM_ID=
# Code taxe 0 % TVA (non taxable). Managed Payments désactivé au checkout.
STRIPE_PRODUCT_TAX_CODE=txcd_00000000
# Taux de taxe manuel TVA 0 % (créé auto si vide)
STRIPE_TAX_RATE_ZERO_VAT=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_QUARTERLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Webhook endpoint : https://ecoboty.eu/webhooks/stripe
# Customer Portal : activer dans Stripe Dashboard > Settings > Billing > Customer portal

# --- PROD (Plesk) — décommenter / remplacer sur le serveur ---
# NODE_ENV=production
# PORT=4000
# BASE_URL=https://ecoboty.eu
# API_BASE=
# API_SECRET_KEY=...
# API_JWT_TTL=30d
