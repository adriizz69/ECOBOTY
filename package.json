{
  "name": "ecoboty",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build",
    "dev": "npm run dev -w @ecoboty/server",
    "dev:web": "npm run dev -w @ecoboty/web",
    "dev:all": "concurrently -k -n server,web -c blue,green \"npm run dev -w @ecoboty/server\" \"npm run dev:web\"",
    "build": "node scripts/build-web.js",
    "prestart": "npm run migrate",
    "start": "npm run start -w @ecoboty/server",
    "migrate": "npm run migrate -w @ecoboty/db",
    "register-commands": "npm run register-commands -w @ecoboty/server",
    "lint": "node --check apps/server/src/index.js && node --check packages/core/src/create-app.js",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=26.5.0"
  }
}
